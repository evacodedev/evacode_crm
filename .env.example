# Copy to .env and adjust. Never commit real Business.Ru credentials.

DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api

POSTGRES_DB=evacode_crm
POSTGRES_USER=evacode
POSTGRES_PASSWORD=evacode
POSTGRES_HOST=db
POSTGRES_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0

CORS_ALLOWED_ORIGINS=http://localhost:43123,http://127.0.0.1:43123,http://localhost:5173,http://127.0.0.1:5173

DEMO_SALES_PASSWORD=sales123

# Optional local-without-Docker:
# USE_SQLITE=1
# CELERY_TASK_ALWAYS_EAGER=1

# Business.Ru — not used in MVP stub
# BUSINESS_RU_API_URL=
# BUSINESS_RU_APP_ID=
# BUSINESS_RU_SECRET=
